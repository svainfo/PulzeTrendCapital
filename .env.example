# =============================================
# PulzeTrend Capital — Environment Variables
# Copy this file to .env.local for local development
# =============================================

# ── Site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email / SMTP (Nodemailer) ─────────────────
# Supports any SMTP provider: Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form submissions are emailed to
CONTACT_EMAIL=contact@pulzetrendcapital.com

# ── Google reCAPTCHA v3 (optional) ────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ── Analytics (optional) ──────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── CRM Integration (future) ──────────────────
# CRM_API_URL=https://your-crm.com/api
# CRM_API_KEY=your-crm-api-key

# ── Newsletter (future) ────────────────────────
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_LIST_ID=your-list-id
